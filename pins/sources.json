    {
      "id": "babelstone",
      "name": "BabelStone IDS (Ideographic Description Sequences for CJK Unified Ideographs)",
      "role": "description",
      "url": "https://www.babelstone.co.uk/CJK/IDS.TXT",
      "pin": "File Date 2025-06-27 (Unicode 16.0)",
      "retrieved": "2026-11-15",
      "files": [
        {
          "file": "IDS.TXT",
          "url": "https://www.babelstone.co.uk/CJK/IDS.TXT",
          "mirrors": [
            "https://web.archive.org/web/20250630223601id_/https://babelstone.co.uk/CJK/IDS.TXT"
          ],
          "sha256": "cc2a0a97e6a51ed6ebe59870ef2af66e83f3c3c27387d79b4441bb2d791d78b1"
        }
      ],
      "licence": "LicenseRef-BabelStone-IDS",
      "licenceEvidence": "IDS.TXT header, note 2: under U.S. copyright law data is not eligible for copyright protection, and IDS descriptions are held to be such data; anyone may use the data for personal or commercial purposes without asking permission or providing attribution; the maintainer waives copyright claims to the file's presentation.",
      "licenceFile": "LicenseRef-BabelStone-IDS.txt",
      "attribution": "BabelStone IDS by Andrew West (魏安), File Date 2025-06-27, https://www.babelstone.co.uk/CJK/IDS.TXT",
      "weakness": "The file has no versioned URL; the pin is its File Date and digest. A sequence describes a character's form in the regions it is tagged with, which need not be the form a given font draws. Its header (note 1) says the data draws on Kawabata Taichi's IDS data and on IRG submissions; note 2 rests on U.S. law."
    },
